# Cache na Cloudflare. Os arquivos em /assets têm hash no nome, então podem ficar em cache "para sempre".
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Imagens e fontes não têm hash: cache de 30 dias, revalidando em segundo plano.
/img/*
  Cache-Control: public, max-age=2592000, stale-while-revalidate=86400
/work/*
  Cache-Control: public, max-age=2592000, stale-while-revalidate=86400
/og.jpg
  Cache-Control: public, max-age=604800

# HTML sempre revalida, para o deploy novo aparecer na hora.
/
  Cache-Control: public, max-age=0, must-revalidate
/index.html
  Cache-Control: public, max-age=0, must-revalidate
